generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SIRAH_VIEWER
  SIRAH_REVIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RegionGroup {
  SOUTH_ASIA
  GLOBAL
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  NAYAPAY
}

enum RegistrationStatus {
  PENDING_PAYMENT
  PAID
  MANUAL_REVIEW
  ACTIVE
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  UNDER_REVIEW
  CONFIRMED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FreeWarriorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id               String     @id @default(cuid())
  fullName         String
  email            String     @unique
  phoneCountryCode String
  phoneNumber      String
  passwordHash     String
  role             UserRole   @default(STUDENT)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sirahOrders             SirahOrder[]
  studentProfile          StudentProfile?
  registrations           Registration[]
  enrollments             Enrollment[]
  sessions                Session[]
  subscriptions           Subscription[]
  emailLogs               EmailLog[]
  freeWarriorApplications FreeWarriorApplication[]
  sirahLessonProgress     SirahLessonProgress[]
  sirahClassroomEmails    SirahClassroomEmail[]
  passwordResetTokens     PasswordResetToken[]
  /// Prisma-side back-relation only: no column on User.
  lmsNotifications        LmsNotification[]
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  countryCode String
  countryName String
  timezone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  basePrice   Int
  currency    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sirahOrders   SirahOrder[]
  pricingRules  PricingRule[]
  coupons       Coupon[]
  registrations Registration[]
  enrollments   Enrollment[]
}

model PricingRule {
  id           String      @id @default(cuid())
  courseId     String
  countryCode  String
  regionGroup  RegionGroup
  currency     String
  amount       Int
  isDiscounted Boolean     @default(false)
  activeFrom   DateTime?
  activeTo     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, countryCode])
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  type               CouponType
  value              Int
  applicableRegion   RegionGroup?
  applicableCourseId String?
  maxRedemptions     Int?
  usedCount          Int          @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  applicableCourse Course?        @relation(fields: [applicableCourseId], references: [id], onDelete: SetNull)
  registrations    Registration[]
}

model Registration {
  id                   String             @id @default(cuid())
  userId               String
  courseId             String
  selectedCountryCode  String
  selectedCountryName  String
  selectedCurrency     String
  baseAmount           Int
  autoDiscountAmount   Int                @default(0)
  couponDiscountAmount Int                @default(0)
  finalAmount          Int
  paymentMethod        PaymentMethod
  paymentReference     String?            @unique
  status               RegistrationStatus @default(PENDING_PAYMENT)
  couponId             String?
  couponCode           String?
  pricingSnapshot      Json
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  sirahOrder   SirahOrder?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment      Payment?
  enrollment   Enrollment?
  subscription Subscription?
}

model Payment {
  id                String        @id @default(cuid())
  registrationId    String        @unique
  provider          PaymentMethod
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  currency          String
  status            PaymentStatus @default(INITIATED)
  manualNotes       String?
  paidAt            DateTime?
  rawPayloadJson    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration     Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  manualSubmission ManualPaymentSubmission?
}

model ManualPaymentSubmission {
  id                String        @id @default(cuid())
  paymentId         String        @unique
  method            PaymentMethod
  senderName        String
  senderNumber      String
  referenceKey      String
  screenshotUrl     String?
  notes             String?
  submittedAt       DateTime      @default(now())
  reviewedByAdminId String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  courseId       String
  registrationId String           @unique
  status         EnrollmentStatus @default(PENDING)
  activatedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  registrationId         String               @unique
  provider               SubscriptionProvider
  status                 SubscriptionStatus   @default(INCOMPLETE)
  providerSubscriptionId String?              @unique
  providerCustomerId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  canceledAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id         String    @id @default(cuid())
  userId     String?
  toEmail    String
  emailType  String
  subject    String
  status     String
  providerId String?
  error      String?
  payload    Json?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, emailType])
}

model MissionSupportDonation {
  id                     String        @id @default(cuid())
  fullName               String
  email                  String
  phoneCountryCode       String?
  phoneNumber            String?
  countryName            String?
  amount                 Int
  currency               String        @default("GBP")
  paymentMethod          PaymentMethod
  paymentReference       String?       @unique
  status                 PaymentStatus @default(INITIATED)
  donorMessage           String?
  providerOrderId        String?
  providerPaymentId      String?
  manualNotes            String?
  paidAt                 DateTime?
  rawPayloadJson         Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  frequency              String        @default("ONE_TIME")
  purpose                String        @default("WHERE_NEEDED")
  providerCustomerId     String?
  providerSubscriptionId String?       @unique
  subscriptionStatus     String?
  cancelAtPeriodEnd      Boolean       @default(false)
  checkoutKey            String?       @unique

  manualSubmission MissionSupportManualSubmission?
  payments         MissionSupportPayment[]

  @@index([email, createdAt])
  @@index([status, paymentMethod])
}

model MissionSupportPayment {
  id                String                 @id @default(cuid())
  donationId        String
  providerReference String                 @unique
  providerPaymentId String?
  providerInvoiceId String?
  amount            Int
  currency          String                 @default("GBP")
  status            String
  refundedAmount    Int                    @default(0)
  pendingRefundAmount Int?
  paidAt            DateTime?
  receiptUrl        String?
  receiptSentAt     DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  donation          MissionSupportDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId, createdAt])
  @@index([providerPaymentId])
}

model MissionSupportWebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model MissionSupportManualSubmission {
  id            String        @id @default(cuid())
  donationId    String        @unique
  method        PaymentMethod
  senderName    String
  senderNumber  String
  referenceKey  String
  screenshotUrl String?
  notes         String?
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  donation MissionSupportDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model FreeWarriorReceipt {
  id            String @id @default(cuid())
  applicationId String @unique
  method        String
  filename      String
  mime          String
  sha256        String
  data          Bytes @db.LongBlob
  createdAt     DateTime @default(now())
  application   FreeWarriorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model FreeWarriorApplication {
  receipt              FreeWarriorReceipt?
  scholarshipBatch     String?
  scholarshipDetails   Json?
  id                   String                       @id @default(cuid())
  fullName             String
  email                String
  whatsapp             String
  age                  Int?
  cityCountry          String
  occupation           String
  knowledgeLevel       String
  previousSeerahStudy  String?
  currentInvolvement   String?
  whatDrawsYou         String
  howItBenefits        String
  mostInterestingTopic String
  whyThisTopic         String
  canAttendRegularly   String
  attendedOrientation  Boolean
  reasonForWaiver      String
  howHeard             String?
  adabCommitment       Boolean
  genuineFinancialNeed Boolean
  courseSlug           String
  courseTitle          String
  listedPrice          String
  status               FreeWarriorApplicationStatus @default(PENDING)
  reviewNote           String?
  reviewedBy           String? @db.VarChar(320)
  reviewedAt           DateTime?
  approvedUserId       String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  approvedUser User? @relation(fields: [approvedUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([approvedUserId])
  @@index([scholarshipBatch, status])
}

// Additive current-campaign records. Historical Registration/Payment amounts are untouched.
model SirahManualDiscount {
  id              String @id @default(cuid())
  codeHash        String @unique
  codePlain       String?
  email           String
  batchCode       String
  countryCode     String
  plan            String
  currency        String
  amountMinor     Int
  /// MANUAL = Pakistan bank/JazzCash (all codes before card discounts); CARD = Stripe checkout.
  paymentScope    String   @default("MANUAL") @db.VarChar(16)
  isActive        Boolean @default(true)
  maxRedemptions  Int      @default(1)
  redeemedCount   Int      @default(0)
  redeemedEmail   String?
  redeemedOrderId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email, batchCode, isActive])
}

model SirahOrder {
  discount               Json?
  id                     String              @id @default(cuid())
  userId                 String
  courseId               String
  batchCode              String
  reference              String              @unique
  requestKey             String              @unique
  registrationId         String?             @unique
  phoneCountry           String
  phoneE164              String
  countryCode            String
  countryName            String
  marketCode             String
  plan                   String
  method                 String?
  pricingVersion         String
  currency               String
  amountMinor            Int
  totalMinor             Int
  paymentState           String              @default("UNPAID")
  enrolmentState         String              @default("PENDING")
  revision               Int                 @default(0)
  terms                  Json?
  providerOrderId        String?             @unique
  checkoutToken          String?             @unique
  providerPlanId         String?
  cancelledAt            DateTime?
  accessEndsAt           DateTime?
  refundedMinor          Int                 @default(0)
  providerSubscriptionId String?             @unique
  providerCustomerId     String?
  programmeStart         DateTime?
  programmeEnd           DateTime?
  nextBillingAt          DateTime?
  /// Cohort billing cycle this order follows (lib/sirah/billing-cycle.ts),
  /// copied from SirahCohort when the order joined it. All three null: the
  /// legacy anniversary schedule (existing card subscriptions, PayPal).
  cycleBillingDay        Int?
  cycleGraceDay          Int?
  /// The renewal due after the first payment; later dues are whole months on.
  cycleFirstDueAt        DateTime?           @db.DateTime(3)
  paidMinor              Int                 @default(0)
  paidCount              Int                 @default(0)
  invitationState        String              @default("PENDING")
  /// Manually confirmed by staff: student added to the course WhatsApp group.
  /// Separate from invitationState (the automatic invitation email).
  groupAddedAt           DateTime?           @db.DateTime(3)
  groupAddedBy           String?             @db.VarChar(320)
  /// Super admin marked this as a test/junk record: hidden from admin lists,
  /// CSV and Overview counts. Data kept; null = included (reversible).
  excludedAt             DateTime?           @db.DateTime(3)
  excludedBy             String?             @db.VarChar(320)
  /// Super admin "deleted" this payment-free record: a soft delete, hidden
  /// everywhere except the admin Archive view. Restorable until the
  /// maintenance job purges it 7 days after this time. Separate from excludedAt.
  archivedAt             DateTime?           @db.DateTime(3)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  course                 Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  registration           Registration?       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  receipts               SirahReceipt[]
  audits                 SirahAudit[]
  events                 SirahPaymentEvent[]
  notifications          SirahNotification[]
  resumeLinks            SirahResumeLink[]

  @@unique([userId, courseId, batchCode])
  @@index([paymentState, enrolmentState, createdAt])
  @@index([groupAddedAt])
  @@index([excludedAt])
  @@index([archivedAt])
}

model SirahReceipt {
  id        String     @id @default(cuid())
  orderId   String
  revision  Int
  filename  String
  mime      String
  sha256    String
  data      Bytes      @db.LongBlob
  createdAt DateTime   @default(now())
  order     SirahOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, revision])
}

model SirahAudit {
  id        String     @id @default(cuid())
  orderId   String
  actor     String
  action    String
  detail    Json
  createdAt DateTime   @default(now())
  order     SirahOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model SirahPaymentEvent {
  id          String     @id
  orderId     String
  provider    String
  amountMinor Int
  currency    String
  kind        String
  createdAt   DateTime   @default(now())
  order       SirahOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model SirahNotification {
  id          String     @id @default(cuid())
  key         String     @unique
  orderId     String
  toEmail     String
  kind        String
  payload     Json
  state       String     @default("PENDING")
  attempts    Int        @default(0)
  lockedUntil DateTime?
  providerId  String?
  error       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  order       SirahOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([state, lockedUntil])
}

// Scoped payment-resume grants; these never create a general account session.
model SirahResumeLink {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  orderId   String
  expiresAt DateTime
  createdAt DateTime   @default(now())
  order     SirahOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// Current Sīrah cohort schedule. Null is explicitly pending; orientation is separate.
model SirahCohort {
  batchCode      String   @id
  commencementAt DateTime? @db.DateTime(3)
  confirmedAt    DateTime? @db.DateTime(3)
  confirmedBy    String?
  sourceReference String?
  revision       Int      @default(0)
  history        Json?
  /// Monthly renewals fall due on this day of every month (Pakistan calendar),
  /// the same day for every student in the cohort. 1–28.
  billingDay     Int      @default(7)
  /// An unpaid renewal keeps access open through the end of this day of the
  /// same month; after it, access pauses until payment. Must be after billingDay.
  graceDay       Int      @default(15)
  updatedAt      DateTime @updatedAt
  /// Prisma-side back-relations only: no column on SirahCohort.
  lmsSessions    LmsSession[]
  lmsResources     LmsResource[]
  lmsAnnouncements LmsAnnouncement[]
}

/// Append-only record of Sīrah workspace access changes (add, promote, demote,
/// revoke): who changed whose role or status, and when. No foreign key, so the
/// record survives any later change to the target account.
model SirahAccessAudit {
  id           String   @id @default(cuid())
  actor        String   @db.VarChar(320)
  action       String   @db.VarChar(32)
  targetUserId String?  @db.VarChar(191)
  targetEmail  String   @db.VarChar(320)
  fromRole     String?  @db.VarChar(32)
  toRole       String?  @db.VarChar(32)
  fromStatus   String?  @db.VarChar(32)
  toStatus     String?  @db.VarChar(32)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt])
  @@index([targetEmail, createdAt])
}

/// Append-only record of payment-free test orders a super admin deleted
/// permanently (the order's own audit rows are deleted with it).
model SirahRecordDeletion {
  id         String   @id @default(cuid())
  orderId    String   @db.VarChar(191)
  reference  String   @db.VarChar(191)
  email      String   @db.VarChar(320)
  fullName   String   @db.VarChar(191)
  actor      String   @db.VarChar(320)
  snapshot   Json
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt])
  @@index([reference])
}

enum SirahMaterialKind {
  SLIDES
  PDF
  READING
  LINK
  RECORDING
}

/// One weekly Sīrah teaching session. Status (upcoming / live / past) is
/// derived from scheduledAt at read time, never stored.
model SirahLesson {
  id            String          @id @default(cuid())
  title         String          @db.VarChar(191)
  summary       String          @db.Text
  weekNumber    Int
  scheduledAt   DateTime        @db.DateTime(3)
  zoomJoinUrl   String?         @db.VarChar(1024)
  zoomMeetingId String?         @db.VarChar(64)
  createdAt     DateTime        @default(now()) @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @db.DateTime(3)
  materials     SirahMaterial[]
  progress      SirahLessonProgress[]

  @@index([scheduledAt])
  @@index([weekNumber])
}

/// Session material. lessonId null = course-wide (not tied to one session).
model SirahMaterial {
  id        String            @id @default(cuid())
  lessonId  String?
  title     String            @db.VarChar(191)
  kind      SirahMaterialKind
  url       String            @db.VarChar(1024)
  order     Int               @default(0)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  lesson    SirahLesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// LINK: url is the pasted link. UPLOAD: the file lives in Spaces under
  /// objectKey, and url is the enrolment-checked route that serves it.
  storage          SirahMaterialStorage @default(LINK)
  objectKey        String?              @unique @db.VarChar(191)
  contentType      String?              @db.VarChar(191)
  sizeBytes        BigInt?
  originalFilename String?              @db.VarChar(255)

  @@index([lessonId, order])
}

enum SirahMaterialStorage {
  LINK
  UPLOAD
}

model SirahAnnouncement {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(191)
  body        String   @db.Text
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now()) @db.DateTime(3)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  /// Whether enrolled students were emailed (false: a quiet post).
  emailStudents Boolean @default(false)

  @@index([pinned, publishedAt])
}

/// A student's own completion mark on a session. studentId is the User id the
/// enrolment check resolves (getSirahStudentAccess). completedAt null =
/// marked incomplete again; the row is kept so the toggle is an upsert.
model SirahLessonProgress {
  id          String      @id @default(cuid())
  lessonId    String
  studentId   String
  completedAt DateTime?   @db.DateTime(3)
  createdAt   DateTime    @default(now()) @db.DateTime(3)
  lesson      SirahLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

/// Classroom emails: WELCOME (once per student), REMINDER (once per session
/// per student) and ANNOUNCEMENT (once per post per student). `key` is unique
/// per kind, subject and student, so nothing can be queued, or sent, twice.
/// The message is rendered at send time from the current session details.
model SirahClassroomEmail {
  id             String    @id @default(cuid())
  key            String    @unique @db.VarChar(191)
  kind           String    @db.VarChar(32)
  userId         String
  lessonId       String?   @db.VarChar(191)
  announcementId String?   @db.VarChar(191)
  toEmail        String    @db.VarChar(191)
  subject        String?   @db.VarChar(191)
  state          String    @default("PENDING") @db.VarChar(32)
  attempts       Int       @default(0)
  lockedUntil    DateTime? @db.DateTime(3)
  providerId     String?   @db.VarChar(191)
  error          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  sentAt         DateTime? @db.DateTime(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, lockedUntil])
  @@index([userId])
}

/// Student password reset links. Only the SHA-256 of the token is stored; a
/// row is spent (usedAt) on use, on a newer request, or on a successful reset.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── LMS: Zoom-backed live sessions ─────────────────────────────────────────

/// A Zoom user that can host LMS sessions. Licensed hosts are required for
/// meetings longer than 40 minutes with three or more participants.
model ZoomHost {
  id         String       @id @default(cuid())
  zoomUserId String       @unique @db.VarChar(64)
  email      String       @db.VarChar(320)
  licensed   Boolean      @default(false)
  revenuePartner Boolean?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)
  sessions   LmsSession[]

  @@index([active])
}

enum LmsSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// One scheduled live class for a cohort, backed by a Zoom meeting (or one
/// occurrence of a recurring meeting). Named LmsSession because `Session`
/// already holds student login sessions. startsAt is stored in UTC.
/// joinUrl and passcode are stored encrypted, never in plain text.
model LmsSession {
  id                String           @id @default(cuid())
  cohortId          String
  title             String           @db.VarChar(191)
  startsAt          DateTime         @db.DateTime(3)
  durationMin       Int
  status            LmsSessionStatus @default(SCHEDULED)
  zoomHostId        String
  zoomMeetingId     String?          @db.VarChar(64)
  zoomMeetingUuid   String?          @db.VarChar(128)
  zoomOccurrenceId  String?          @db.VarChar(64)
  joinUrlEncrypted  String?          @db.Text
  passcodeEncrypted String?          @db.Text
  createdAt         DateTime         @default(now()) @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @db.DateTime(3)
  /// When Zoom reported the meeting started / ended (meeting.started,
  /// meeting.ended webhooks). Null until the event arrives.
  zoomStartedAt     DateTime?        @db.DateTime(3)
  zoomEndedAt       DateTime?        @db.DateTime(3)

  cohort      SirahCohort         @relation(fields: [cohortId], references: [batchCode], onDelete: Restrict)
  zoomHost    ZoomHost            @relation(fields: [zoomHostId], references: [id], onDelete: Restrict)
  /// Prisma-side back-relations only: no column on LmsSession.
  joinIntents SessionJoinIntent[]
  attendanceIntervals AttendanceInterval[]
  attendance  Attendance[]
  resources           LmsResource[]
  recordings          Recording[]

  @@index([cohortId, startsAt])
  @@index([zoomHostId, startsAt])
  @@index([zoomMeetingId])
  @@index([status, startsAt])
}

/// Raw Zoom webhook deliveries, stored before any processing. dedupeKey is a
/// SHA-256 of (event, event_ts, payload.object.uuid) so Zoom retries are
/// recorded once.
model ZoomWebhookEvent {
  id          String    @id @default(cuid())
  dedupeKey   String    @unique @db.VarChar(64)
  event       String    @db.VarChar(128)
  payload     Json
  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)
  error       String?   @db.Text

  @@index([processedAt, receivedAt])
  @@index([event, receivedAt])
}

/// Append-only log: a student passed every check on the join route and was
/// redirected to Zoom. Records intent to join, not attendance (attendance
/// comes from Zoom participant reports). userId has no foreign key, like
/// SirahAccessAudit, so the log never blocks or follows a change to User.
model SessionJoinIntent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String   @db.VarChar(191)
  at        DateTime @default(now()) @db.DateTime(3)

  session LmsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([userId, at])
}

/// How a Zoom participant was tied to a student account: the participant's
/// email equals an enrolled student's account email, else an exact display
/// name match, else none (kept unmatched, userId null).
enum AttendanceMatchMethod {
  EMAIL
  NAME
  NONE
}

/// One stretch of one Zoom participant in a session's meeting, from the
/// participant_joined / participant_left webhooks and the post-meeting
/// participants report. Natural key: (session, Zoom participant id, joinedAt),
/// so webhook and report rows for the same stretch are one row. userId has no
/// foreign key (like SessionJoinIntent): the log never blocks a user deletion.
model AttendanceInterval {
  id                String                @id @default(cuid())
  sessionId         String
  userId            String?               @db.VarChar(191)
  zoomParticipantId String                @db.VarChar(191)
  email             String?               @db.VarChar(320)
  name              String?               @db.VarChar(191)
  joinedAt          DateTime              @db.DateTime(3)
  leftAt            DateTime?             @db.DateTime(3)
  matchMethod       AttendanceMatchMethod @default(NONE)
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @db.DateTime(3)

  session LmsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, zoomParticipantId, joinedAt])
  @@index([sessionId, userId])
  @@index([sessionId, leftAt])
}

/// JOINED while the meeting runs; PRESENT or PARTIAL once it has ended.
enum AttendanceStatus {
  JOINED
  PRESENT
  PARTIAL
}

/// One matched student's attendance for one session, recomputed from their
/// AttendanceIntervals (overlapping stretches counted once). userId has no
/// foreign key, as above.
model Attendance {
  id            String           @id @default(cuid())
  sessionId     String
  userId        String           @db.VarChar(191)
  status        AttendanceStatus @default(JOINED)
  joinedMinutes Int              @default(0)
  firstJoinedAt DateTime         @db.DateTime(3)
  lastLeftAt    DateTime?        @db.DateTime(3)
  createdAt     DateTime         @default(now()) @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @db.DateTime(3)

  session LmsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// ── LMS Phase 5: resources, announcements, notifications ───────────────────

enum LmsResourceKind {
  FILE
  LINK
}

enum LmsVisibility {
  HIDDEN
  PUBLISHED
}

/// A course material for a whole cohort (cohortId set) or one live session
/// (sessionId set; its cohort is the session's). Exactly one of the two is
/// set, enforced by the service. FILE: the object lives in the private Spaces
/// bucket under storageKey and reaches students only as a short-lived
/// presigned GET from the enrolment-checked route; url stays null. LINK: url
/// is the https link; storageKey stays null. Hidden until published.
model LmsResource {
  id               String          @id @default(cuid())
  cohortId         String?
  sessionId        String?
  parentRecordingId String?
  title            String          @db.VarChar(191)
  kind             LmsResourceKind
  storageKey       String?         @unique @db.VarChar(191)
  url              String?         @db.VarChar(1024)
  contentType      String?         @db.VarChar(191)
  sizeBytes        BigInt?
  originalFilename String?         @db.VarChar(255)
  visibility       LmsVisibility   @default(HIDDEN)
  publishedAt      DateTime?       @db.DateTime(3)
  uploadedBy       String          @db.VarChar(320)
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @db.DateTime(3)

  cohort  SirahCohort? @relation(fields: [cohortId], references: [batchCode], onDelete: Restrict)
  session LmsSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([cohortId, visibility])
  @@index([sessionId, visibility])
}

/// A notice to one cohort. publishedAt null = draft (students never see it).
model LmsAnnouncement {
  id          String    @id @default(cuid())
  cohortId    String
  title       String    @db.VarChar(191)
  body        String    @db.Text
  publishedAt DateTime? @db.DateTime(3)
  createdBy   String    @db.VarChar(320)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  cohort SirahCohort @relation(fields: [cohortId], references: [batchCode], onDelete: Restrict)

  @@index([cohortId, publishedAt])
}

/// One in-app notification for one student, and its email. dedupeKey is
/// unique per (event, subject, student), so an event never notifies or
/// emails anyone twice. emailState: null = in-app only; PENDING / SENDING /
/// FAILED while queued; SENT, CANCELLED or GAVE_UP when settled. The email is
/// rendered and the enrolment re-checked when it is sent.
model LmsNotification {
  id               String    @id @default(cuid())
  userId           String
  type             String    @db.VarChar(64)
  title            String    @db.VarChar(191)
  body             String    @db.Text
  link             String?   @db.VarChar(1024)
  readAt           DateTime? @db.DateTime(3)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  dedupeKey        String    @unique @db.VarChar(191)
  emailState       String?   @db.VarChar(32)
  emailAttempts    Int       @default(0)
  emailLockedUntil DateTime? @db.DateTime(3)
  emailSentAt      DateTime? @db.DateTime(3)
  emailProviderId  String?   @db.VarChar(191)
  emailError       String?   @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([emailState, emailLockedUntil])
}

/// Where a recording or one of its files is in the copy from Zoom cloud
/// storage into our own object storage (lib/lms/recordings).
enum RecordingCopyStatus {
  PENDING
  COPYING
  READY
  FAILED
}

/// Whether enrolled students may watch a recording. New recordings start
/// HIDDEN; staff publish them from the Live sessions admin.
enum RecordingVisibility {
  HIDDEN
  PUBLISHED
}

/// Which Zoom cloud-recording file an asset is.
enum RecordingAssetKind {
  VIDEO
  AUDIO
  TRANSCRIPT
  CHAT
}

/// One Zoom cloud recording of a session's meeting instance (one meeting
/// UUID), ingested from recording.completed webhooks or the backfill. status
/// follows its primary media file (VIDEO, else AUDIO). The Zoom cloud copy is
/// kept; nothing here deletes it.
model Recording {
  id              String              @id @default(cuid())
  sessionId       String
  zoomMeetingUuid String              @unique @db.VarChar(128)
  startedAt       DateTime?           @db.DateTime(3)
  endedAt         DateTime?           @db.DateTime(3)
  status          RecordingCopyStatus @default(PENDING)
  visibility      RecordingVisibility @default(HIDDEN)
  publishedAt     DateTime?           @db.DateTime(3)
  attempts        Int                 @default(0)
  lastError       String?             @db.Text
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)

  session LmsSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assets  RecordingAsset[]

  @@index([sessionId])
  @@index([status, visibility])
}

/// One file of a Recording, copied from Zoom into object storage. storageKey
/// is set once the object is stored; it is never sent to a browser (students
/// get a short-lived presigned URL from the play route instead).
model RecordingAsset {
  id          String              @id @default(cuid())
  recordingId String
  kind        RecordingAssetKind
  zoomFileId  String              @unique @db.VarChar(191)
  sizeBytes   BigInt              @default(0)
  storageKey  String?             @db.VarChar(512)
  status      RecordingCopyStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?             @db.Text
  createdAt   DateTime            @default(now()) @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @db.DateTime(3)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
  @@index([status, updatedAt])
}
