{
  "name": "global-awakening-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:mission-support": "node --test scripts/test-mission-support.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.mjs",
    "test:seerah": "node --test scripts/test-seerah-config.mjs",
    "test:sirah-workflow": "node --conditions=react-server --import tsx --test scripts/test-sirah-workflow.ts",
    "test:sirah-team": "node --conditions=react-server --import tsx --test scripts/test-sirah-team-access.ts",
    "sirah:database:status": "node scripts/sirah-database-status.cjs",
    "sirah:stripe:check": "node --import tsx scripts/check-sirah-stripe.ts",
    "sirah:stripe:sandbox:renewal": "node --import tsx scripts/check-sirah-sandbox-renewal.ts",
    "sirah:launch:check": "node --conditions=react-server --import tsx scripts/check-sirah-launch.ts",
    "test:sirah-scholarship": "node --conditions=react-server --import tsx --test scripts/test-sirah-scholarship.ts"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "countries-list": "^3.3.0",
    "file-type": "^21.3.4",
    "framer-motion": "^12.35.0",
    "libphonenumber-js": "^1.13.15",
    "maxmind": "^5.0.8",
    "next": "16.1.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^20.4.1",
    "swiper": "^12.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
