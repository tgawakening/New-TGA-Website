# Copy this file to .env.local (or .env) and fill in real values.
# Do not commit real secrets.

# Local development:
# Keep localhost only for the website URL. The database can be fully remote.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preferred setup for both local development and production:
# Point Prisma directly to your managed DigitalOcean MySQL database.
DATABASE_URL="mysql://doadmin:password@db-host:25060/defaultdb?sslcert=./certs/ca-certificate.crt&sslaccept=strict"

# Optional local-only database example if you intentionally run MySQL on your laptop:
# DATABASE_URL="mysql://root:password@localhost:3306/global_awakening"
ADMIN_API_TOKEN="replace_with_long_random_admin_token"
ADMIN_DASHBOARD_EMAIL="admin@example.com"
ADMIN_DASHBOARD_PASSWORD="replace_with_admin_password"
ADMIN_DASHBOARD_SECRET="replace_with_long_random_admin_session_secret"

# Stripe
# Optional for future client-side Stripe usage:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Mission support: disabled until a separate staging database, Stripe test-mode
# checkout, webhook deliveries, emails and approved contribution terms are verified.
# See docs/MISSION_SUPPORT_SETUP.md. Never put secrets in NEXT_PUBLIC_* variables.
MISSION_SUPPORT_PAYMENTS_ENABLED="false"
MISSION_SUPPORT_LIVE_APPROVED="false"
MISSION_SUPPORT_MANAGEMENT_SECRET="replace_with_at_least_32_random_characters"
MISSION_SUPPORT_POLICY_URL=""
MISSION_SUPPORT_ALLOCATION_NOTICE=""
# Optional Stripe Billing Portal configuration with cancellation enabled:
MISSION_SUPPORT_PORTAL_CONFIGURATION_ID=""
# Optional verified report URL and approved local classroom image from public/:
MISSION_SUPPORT_IMPACT_REPORT_URL=""
MISSION_SUPPORT_HERO_IMAGE=""
MISSION_SUPPORT_HERO_CAPTION=""

# PayPal
PAYPAL_ENV="sandbox" # sandbox or live
PAYPAL_CLIENT_ID="paypal_client_id"
PAYPAL_CLIENT_SECRET="paypal_client_secret"
PAYPAL_PLAN_STANDARD_MONTHLY="P-REPLACE_WITH_STANDARD_MONTHLY_PLAN_ID"
PAYPAL_PLAN_SOUTH_ASIA_MONTHLY="P-REPLACE_WITH_SOUTH_ASIA_MONTHLY_PLAN_ID"

# Email
RESEND_API_KEY="re_xxx"
# Must be a sender on a verified domain in Resend, not a plain Gmail address.
EMAIL_FROM="Global Awakening <noreply@your-domain.com>"
ADMIN_NOTIFICATION_EMAIL="tgawakening786@gmail.com"

# Example:
# API_BASE_URL=https://api.example.com
# API_KEY=replace_me

# Beyond Chronology: all payment routes stay inactive until their terms and
# verified currency/merchant configuration are supplied. Do not paste test terms.
SIRAH_MONTHLY_TERMS_JSON=
SIRAH_ANNUAL_TERMS_JSON=
SIRAH_MANUAL_ACCOUNTS_VERIFIED=false
# Optional per-account overrides; blank inherits the shared flag above.
# Approve each receiving account separately before setting its override true.
SIRAH_BANK_TRANSFER_VERIFIED=
SIRAH_JAZZCASH_VERIFIED=
SIRAH_LIVE_PAYMENTS_APPROVED=false
SIRAH_PK_RECURRING_VERIFIED=false
SIRAH_STRIPE_ACCOUNT_ID=
SIRAH_STRIPE_MONTHLY_CURRENCIES=
SIRAH_STRIPE_ANNUAL_CURRENCIES=
SIRAH_PAYPAL_MERCHANT_ID=
SIRAH_PAYPAL_WEBHOOK_ID=
SIRAH_PAYPAL_PRODUCT_ID=
SIRAH_PAYPAL_MONTHLY_CURRENCIES=
SIRAH_PAYPAL_ANNUAL_CURRENCIES=
# Server-only invitations. Audience is PAKISTAN or INTERNATIONAL only after approval.
SIRAH_SUPPLIED_GROUP_URL=
SIRAH_SUPPLIED_GROUP_AUDIENCE=
SIRAH_PAKISTAN_GROUP_URL=
SIRAH_INTERNATIONAL_GROUP_URL=
# Optional overrides of account details already present in the previous project.
# Do not enable SIRAH_MANUAL_ACCOUNTS_VERIFIED until finance confirms the accounts.
SIRAH_MEEZAN_HOLDER=
SIRAH_MEEZAN_ACCOUNT=
SIRAH_MEEZAN_IBAN=
SIRAH_JAZZCASH_HOLDER=
SIRAH_JAZZCASH_ACCOUNT=
# Central country rule for protected course invitations (default Pakistan = PK).
SIRAH_PAKISTAN_COUNTRY_CODE=PK

# Server-side residence suggestion only; explicit/saved student choices win.
# APP_PLATFORM: trusted do-connecting-ip + a provisioned GeoLite2 Country database.
# CLOUDFLARE: only after verifying the edge replaces CF-IPCountry (IP Geolocation on).
# Missing/invalid signals or database safely default to PK. No NEXT_PUBLIC_ prefix.
SIRAH_GEO_PROVIDER=
SIRAH_GEOIP_DATABASE_PATH=

# Dedicated NEW Sīrah account only. Leave STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# assigned to the older batch and mission support; there is no fallback to them.
SIRAH_STRIPE_SECRET_KEY=
SIRAH_STRIPE_WEBHOOK_SECRET=
# Historical aggregate evidence only; live activation uses the exact verified route certificates below.
SIRAH_STRIPE_SANDBOX_VERIFIED=false
# Hosted Checkout does not require a publishable key in this application.

# Optional Sīrah-only preferred plan. Reused only after full product/price/schedule checks.
SIRAH_PAYPAL_MONTHLY_PLAN_GBP=
# UK GBP 24.99 uses a separate reusable plan; OTHER GBP 29.99 stays unchanged.
SIRAH_PAYPAL_MONTHLY_PLAN_GB_GBP=
# Isolated sandbox verification runner only; never replace production credentials.
SIRAH_SANDBOX_STRIPE_SECRET_KEY=
SIRAH_SANDBOX_STRIPE_ACCOUNT_ID=

# Optional country-specific terms override; absent falls back to existing terms.
# This keeps Pakistan manual terms and accepted versions unchanged.
SIRAH_GB_ANNUAL_TERMS_JSON=
SIRAH_GB_MONTHLY_TERMS_JSON=
# Explicit operator checkout authorisation, exact country:currency pairs only.
# Also requires that method/country/currency in the selected terms.approvedRoutes.
# These replace redundant legacy activation allowlists, NEVER verification evidence.
# Credentials, merchant/plan checks, consent and verified settlement remain required.
SIRAH_STRIPE_ANNUAL_CHECKOUT_ROUTES=
SIRAH_STRIPE_MONTHLY_CHECKOUT_ROUTES=
SIRAH_PAYPAL_ANNUAL_CHECKOUT_ROUTES=
SIRAH_PAYPAL_MONTHLY_CHECKOUT_ROUTES=
# Legacy independent live route evidence. Do not infer completion
# from credentials, provider plan ACTIVE, or SIRAH_STRIPE_SANDBOX_VERIFIED.
# Exact country:currency pairs, comma-separated, after evidenced route testing.
SIRAH_STRIPE_ANNUAL_VERIFIED_ROUTES=
SIRAH_STRIPE_MONTHLY_VERIFIED_ROUTES=
SIRAH_PAYPAL_ANNUAL_VERIFIED_ROUTES=
SIRAH_PAYPAL_MONTHLY_VERIFIED_ROUTES=
# Manual collection also requires the selected plan's approved terms and its
# verified receiving account. Annual approval cannot enable monthly collection.
SIRAH_BANK_TRANSFER_ANNUAL_VERIFIED_ROUTES=
SIRAH_BANK_TRANSFER_MONTHLY_VERIFIED_ROUTES=
SIRAH_JAZZCASH_ANNUAL_VERIFIED_ROUTES=
SIRAH_JAZZCASH_MONTHLY_VERIFIED_ROUTES=
# Live online activation additionally requires country AND currency allowlists.
SIRAH_STRIPE_ANNUAL_COUNTRIES=
SIRAH_STRIPE_MONTHLY_COUNTRIES=
SIRAH_PAYPAL_ANNUAL_COUNTRIES=
SIRAH_PAYPAL_MONTHLY_COUNTRIES=
# Optional closed provider verification, default off. Server-only JSON array.
# Each grant binds orderId, method, plan, country, currency, amountMinor and an
# ISO expiresAt. Populate only after explicit real-charge authorisation and
# approved terms/tax. Never put credentials or payment instruments in this JSON.
SIRAH_CLOSED_VERIFICATION_CHECKOUTS=[]

# Optional build/runtime provenance binding in App Platform: ${_self.COMMIT_HASH}.
# No secrets. Fallback reads git HEAD at build time when available.
TGA_SOURCE_COMMIT=

# Leave false: production audits inspect existing delivery records without test sends.
ALLOW_OPERATIONAL_TEST_EMAILS="false"
